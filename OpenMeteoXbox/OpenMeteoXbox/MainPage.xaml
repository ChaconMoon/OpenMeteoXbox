<Page
    x:Class="OpenMeteoXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenMeteoXbox"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="750" Width="750" Margin="0,40,0,40">

                <!-- Encabezado -->
                <TextBlock Text="🌤️ Open Meteo Xbox" 
                           FontSize="56" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Consulta el pronóstico meteorológico en tiempo real" 
                           FontSize="18" 
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center"
                           Margin="0,0,0,32"/>

                <!-- Barra de búsqueda tipo Google -->
                <Grid Margin="0,0,0,24" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtCity" 
                             PlaceholderText="Escribe una ciudad (ej. Madrid, Bogotá...)" 
                             KeyDown="OnKeyboardInput" 
                             FontSize="18"
                             Height="48"
                             VerticalContentAlignment="Center"
                             CornerRadius="24,0,0,24"
                             Padding="18,0,18,0"
                             Margin="0,0,-1,0"/>

                    <Button x:Name="btnSearch" 
                            Grid.Column="1" 
                            Content="🔍 Buscar" 
                            Click="btnSearch_Click" 
                            FontSize="18"
                            Height="48"
                            CornerRadius="0,24,24,0"
                            Padding="24,0,24,0"/>
                </Grid>

                <!-- Indicador de carga -->
                <ProgressRing x:Name="progressRing" 
                              IsActive="False" 
                              Visibility="Collapsed" 
                              Width="45" 
                              Height="45" 
                              Margin="0,20,0,20" 
                              HorizontalAlignment="Center"/>

                <!-- Mensaje de Error -->
                <TextBlock x:Name="txtError" 
                           Foreground="Red" 
                           FontSize="14" 
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center" 
                           Margin="0,8,0,8" 
                           Visibility="Collapsed"/>

                <!-- Tarjeta de Resultados del Clima -->
                <Border x:Name="weatherCard" 
                        Background="{ThemeResource SystemControlBackgroundAltHighBrush}" 
                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20" 
                        Margin="0,12,0,20"
                        Visibility="Collapsed">
                    <StackPanel>
                        <!-- Ubicación -->
                        <TextBlock x:Name="txtLocation" 
                                   FontSize="22" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <!-- Icono y Condición -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock x:Name="txtWeatherEmoji" FontSize="36" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtWeatherDescription" FontSize="18" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Temperatura Principal -->
                        <TextBlock x:Name="txtTemperature" 
                                   FontSize="48" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,4,0,16"/>

                        <!-- Detalles Adicionales -->
                        <Grid Margin="0,8,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Sensación" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtApparentTemp" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Humedad" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtHumidity" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Viento" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtWindSpeed" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Botón de Síntesis de Voz -->
                        <Button x:Name="btnSpeak" 
                                Content="🔊 Escuchar pronóstico" 
                                Click="btnSpeak_Click" 
                                HorizontalAlignment="Center" 
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
